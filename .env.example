# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your Discord user id. Turn on Developer Mode, right-click your name, Copy User ID.
DISCORD_OWNER_ID=

# Optional. Right-click your server icon, Copy Server ID.
# Commands show up in that server right away. Leave blank to skip.
DISCORD_GUILD_ID=

# From https://console.x.ai/team/default/api-keys
XAI_API_KEY=

# Model used when you ask a question.
XAI_MODEL=grok-4.7

# none, low, medium, high, or xhigh. low is faster for everyday questions.
XAI_REASONING=low

# IANA timezone. Reminders use this clock.
TIMEZONE=America/Los_Angeles

# Lets the iPhone page and Siri talk to this bot without opening Discord.
# Leave blank to turn that page off. The bot prints nothing from this value.
PHONE_TOKEN=

# Port for the iPhone page on this PC.
PHONE_PORT=8787

# Discord channel that keeps a copy of phone messages, DMs, commands, and reminders.
# Right-click the channel, Copy Channel ID. Leave blank to turn the log off.
LOG_CHANNEL_ID=
