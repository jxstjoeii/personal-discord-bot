# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your Discord user id. Turn on Developer Mode, right-click your name, Copy User ID.
DISCORD_OWNER_ID=

# Optional. Right-click your server icon, Copy Server ID.
# Commands show up in that server right away. Leave blank to skip.
DISCORD_GUILD_ID=

# Your Claude subscription (Pro, Max, Team, or Enterprise). Run .\setup-claude.ps1,
# approve it in the browser, and paste the token it prints here. It lasts a year.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Only if you want to pay per use instead of using your subscription.
# If this is set it wins over the token above, so leave it blank otherwise.
ANTHROPIC_API_KEY=

# sonnet, haiku (faster), or opus (most capable). A full model id works too.
CLAUDE_MODEL=sonnet

# Optional backup brain. When the subscription fails or hits its limit, Patricia
# switches to OpenRouter. Get a key at https://openrouter.ai/settings/keys.
# OpenRouter is pay per use, so set a spending limit on the key there.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. openrouter/auto picks one for you.
OPENROUTER_MODEL=openrouter/auto

# IANA timezone. Reminders use this clock.
TIMEZONE=America/Los_Angeles

# Lets the iPhone page and Siri talk to this bot without opening Discord.
# Leave blank to turn that page off. The bot prints nothing from this value.
PHONE_TOKEN=

# Port for the iPhone page on this PC.
PHONE_PORT=8787

# Discord channel that keeps a copy of phone messages, DMs, commands, and reminders.
# Right-click the channel, Copy Channel ID. Leave blank to turn the log off.
LOG_CHANNEL_ID=

# Lets Patricia plan PowerShell commands for things you want done on this PC.
# Every plan waits for you to press Yes in Discord before anything runs. on or off.
PC_COMMANDS=on

# Seconds each command may run before it is stopped.
PC_COMMAND_TIMEOUT=120

# While one of these games is running, anything Patricia opens goes on the screen
# Discord is on instead of the game screen. Process names, separated by commas.
QUIET_GAMES=Overwatch

# Optional. Server channels where Patricia reads every message from you, without
# an @mention. Channel ids separated by commas. DMs, @mentions, and replies to
# her messages always work.
CHAT_CHANNEL_IDS=

# Where home is, for the weather. A city with state or country, like
# Portland, OR or Amsterdam, NL, or coordinates like 45.52, -122.68.
# When set, this wins over the location in the morning briefing.
WEATHER_LOCATION=
# fahrenheit or celsius. Used when the morning briefing doesn't say.
WEATHER_UNITS=fahrenheit

# Bedtime nudges. From BEDTIME_START, Patricia DMs you every BEDTIME_EVERY minutes,
# firm but kind, until you tell her you're going to bed (or press the button on a
# nudge), or the night ends at BEDTIME_END. on or off.
BEDTIME=on
BEDTIME_START=20:30
BEDTIME_EVERY=30
BEDTIME_END=04:00

# Morning medication check-in. Patricia DMs you at MEDS_TIME with a "Took them" button,
# and asks again every MEDS_EVERY minutes until you tap it or it's MEDS_UNTIL.
# The name comes from the morning briefing's medication list, or set MEDS_NAME.
MEDS=on
MEDS_TIME=9:00
MEDS_EVERY=60
MEDS_UNTIL=13:00
MEDS_NAME=

# Morning hello DM: weather, a motorcycle verdict, what's due, reminders, and something fun.
# Sent once a day at MORNING_TIME, or as soon as Patricia comes online before noon.
MORNING_HELLO=on
MORNING_TIME=8:00

# Ears. Voice messages you send her in Discord are turned into text on this PC with
# Whisper (downloaded once, kept in data/whisper). Audio never leaves the PC.
VOICE_MESSAGES=on
# small.en is accurate and fine on a CPU. base.en is faster, medium.en more accurate.
WHISPER_MODEL=small.en
# cpu, or cuda for an NVIDIA graphics card with CUDA installed.
WHISPER_DEVICE=cpu

# "Hey Patricia" on the PC microphone. Allowed here, but it stays off until you
# switch it on with /listen on (and off with /listen off, or by saying so).
WAKE_WORD=on
# Keep her from responding while a game in QUIET_GAMES is running.
WAKE_DURING_GAMES=off
# Say the answer out loud with Kokoro's Heart voice (from the morning briefing).
VOICE_REPLIES=on
VOICE_NAME=af_heart
# Also DM what you said and what she answered.
VOICE_DM=on
# Optional: a microphone name or number if the default one is wrong.
MIC_DEVICE=
